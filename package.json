{
  "name": "ledgerly",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Ledgerly - Inventory Management System",
  "author": "Muhammad Abdul Rehman Khan",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "build": "tsc && vite build && electron-builder",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps",
    "rebuild:native": "electron-builder install-app-deps --forceBuild",
    "test": "vitest run",
    "test:unit": "vitest run electron/__tests__",
    "test:e2e": "playwright test",
    "rebuild:sqlite": "electron-rebuild -f -w better-sqlite3 -v 38.1.2"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/vite": "^4.1.12",
    "better-sqlite3": "^12.4.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.2",
    "keytar": "^7.9.0",
    "node-machine-id": "^1.1.12",
    "papaparse": "^5.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.64.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.8.1",
    "recharts": "^3.2.1",
    "tailwindcss": "^4.1.12",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@faker-js/faker": "^10.1.0",
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/keytar": "^4.4.0",
    "@types/node": "^22.7.5",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^38.1.2",
    "electron-builder": "^24.13.3",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^27.2.0",
    "playwright": "^1.55.1",
    "typescript": "^5.2.2",
    "vite": "^7.1.2",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^3.2.4"
  }
}
