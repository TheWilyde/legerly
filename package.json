{
  "name": "ledgerly",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Ledgerly - Inventory Management System",
  "author": "Muhammad Abdul Rehman Khan",
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "node scripts/ensure-electron-native.mjs",
    "dev": "vite",
    "type-check": "tsc -p tsconfig.app.json --noEmit",
    "type-check:all": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "pnpm run type-check && vite build",
    "build:release": "pnpm run type-check:all && vite build --mode release && node scripts/run-electron-builder.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "postinstall": "node scripts/rebuild-electron-native.mjs",
    "rebuild:native": "node scripts/rebuild-electron-native.mjs",
    "test": "node scripts/run-tests-with-native-rebuild.mjs",
    "test:raw": "vitest run",
    "test:unit": "node scripts/run-unit-tests-with-native-rebuild.mjs",
    "test:unit:raw": "vitest run electron/__tests__",
    "ensure:electron-native": "node scripts/ensure-electron-native.mjs",
    "rebuild:sqlite": "node scripts/rebuild-electron-native.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "immer": "^11.1.4",
    "keytar": "^7.9.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.8.1",
    "recharts": "^3.2.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.7.5",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vitejs/plugin-react": "^4.2.1",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^27.2.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.2.2",
    "vite": "^7.1.2",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^3.2.4"
  }
}
